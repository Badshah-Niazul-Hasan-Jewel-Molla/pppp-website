{
  "id": "/pppp_bangladesh/",
  "name": "People's Power & Peace Party",
  "short_name": "PPPP",
  "description": "Official website of the People's Power & Peace Party (PPPP) Bangladesh. Power to the People, Peace for the People.",

  "start_url": "/pppp_bangladesh/",
  "scope": "/pppp_bangladesh/",

  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],

  "orientation": "portrait",

  "theme_color": "#ffffff",
  "background_color": "#ffffff",

  "lang": "en",
  "dir": "ltr",

  "prefer_related_applications": false,

  "categories": [
    "politics",
    "government",
    "news",
    "social",
    "education"
  ],

  "iarc_rating_id": "e89d4f5a-0000-0000-0000-000000000000",

  "launch_handler": {
    "client_mode": "focus-existing"
  },

  "scope_extensions": [
    {
      "origin": "https://ppppbangladesh.org"
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "web+pppp",
      "url": "/pppp_bangladesh/?url=%s"
    }
  ],

  "file_handlers": [
    {
      "action": "/pppp_bangladesh/",
      "accept": {
        "text/plain": [".txt"],
        "application/pdf": [".pdf"],
        "application/json": [".json"]
      }
    }
  ],

  "shortcuts": [
    {
      "name": "About PPPP",
      "short_name": "About",
      "description": "Learn about the People's Power & Peace Party",
      "url": "/pppp_bangladesh/about/"
    },
    {
      "name": "Leadership",
      "short_name": "Leadership",
      "description": "View Party Leadership",
      "url": "/pppp_bangladesh/leadership/"
    },
    {
      "name": "Membership",
      "short_name": "Join",
      "description": "Register for Membership",
      "url": "/pppp_bangladesh/membership/"
    },
    {
      "name": "Contact",
      "short_name": "Contact",
      "description": "Contact PPPP Bangladesh",
      "url": "/pppp_bangladesh/contact/"
    }
  ],

  "screenshots": [
    {
      "src": "/pppp_bangladesh/screenshots/home.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Home Screen"
    },
    {
      "src": "/pppp_bangladesh/screenshots/about.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "About Page"
    },
    {
      "src": "/pppp_bangladesh/screenshots/leadership.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Leadership"
    },
    {
      "src": "/pppp_bangladesh/screenshots/membership.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Membership Registration"
    },
    {
      "src": "/pppp_bangladesh/screenshots/contact.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Contact Information"
    },
    {
      "src": "/pppp_bangladesh/screenshots/desktop-home.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop Home Screen"
    },
    {
      "src": "/pppp_bangladesh/screenshots/desktop-about.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop About Page"
    }
  ],

  "related_applications": [
    {
      "platform": "play",
      "id": "com.pppp.bangladesh"
    }
  ],

  "icons": [
    {
      "src": "/pppp_bangladesh/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pppp_bangladesh/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pppp_bangladesh/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}